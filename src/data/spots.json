  { "id": "fish-hoek", "name": "Fish Hoek", "short": "Fish Hoek", "region": "cape-peninsula", "lat": -34.138, "lon": 18.4353, "facing": 105, "swellWindow": [170, 250], "exposure": 0.22, "tide": { "best": ["mid", "high"], "forbidden": [] }, "levels": { "beginner": [1, 3], "intermediate": [2, 4] }, "character": "mellow", "verified": false, "notes": "Sheltered south corner of Fish Hoek Bay. Only breaks on a big S-SW groundswell that refracts deep into False Bay; offshore in W/WSW when Muizenberg is cross-shore. Great white sharks are a documented hazard in this bay." },
  { "id": "glencairn", "name": "Glencairn", "short": "Glencairn", "region": "cape-peninsula", "lat": -34.1598, "lon": 18.4322, "facing": 110, "swellWindow": [160, 250], "exposure": 0.4, "tide": { "best": ["low", "mid"], "forbidden": [] }, "levels": { "intermediate": [2, 5], "advanced": [3, 7] }, "character": "punchy", "verified": false, "notes": "Beach plus a left reef in its own bay south of Elsie's Peak. Needs a solid S-SW groundswell; offshore in W/WNW, and holds far more size than Muizenberg. Strong rips." },
